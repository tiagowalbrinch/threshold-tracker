      "updated": 1773452311792,
      "link": null,
      "locked": false,
      "text": "Ideias futuras\n- Gráfio de evolução\n- Ter como selecionar playlists\n- Vinculo API aimlabs/kovaaks\n- Login com\ndiscord/aimlabs/google\n- APP consumindo as mesmas\napis (bff?)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ideias futuras\n- Gráfio de evolução\n- Ter como selecionar playlists\n- Vinculo API aimlabs/kovaaks\n- Login com discord/aimlabs/google\n- APP consumindo as mesmas apis (bff?)",
      "autoResize": false,
      "lineHeight": 1.25
    },
